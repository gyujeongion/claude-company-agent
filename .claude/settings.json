{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/00_COMPANY/identity.md\" \"$CLAUDE_PROJECT_DIR/00_COMPANY/policy/ai_usage.md\" \"$CLAUDE_PROJECT_DIR/00_COMPANY/policy/scope.md\" \"$CLAUDE_PROJECT_DIR/90_ME/profile.md\" 2>/dev/null"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/boundary_gate.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/secret_guard.py\""
          }
        ]
      }
    ]
  }
}
